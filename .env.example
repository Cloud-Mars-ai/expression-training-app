# 语音识别服务：local 表示原始音频只在本机处理。
ASR_PROVIDER=local
LOCAL_ASR_BASE_URL=http://127.0.0.1:9000/v1
LOCAL_ASR_MODEL=small
# LOCAL_ASR_TIMEOUT_MS=180000
# LOCAL_ASR_API_KEY=

# 如需改用兼容 OpenAI /audio/transcriptions 的云端语音大模型，改为 cloud 并填写下列配置。
# 注意：启用后原始录音会发送到所配置的云端语音服务；不要复用 DeepSeek Key。
# ASR_PROVIDER=cloud
# CLOUD_ASR_BASE_URL=https://api.openai.com/v1
# CLOUD_ASR_MODEL=gpt-4o-mini-transcribe
# CLOUD_ASR_PROVIDER_ID=openai-transcribe
# CLOUD_ASR_TIMEOUT_MS=120000
# CLOUD_ASR_API_KEY=请填写独立的云端语音服务密钥

# DeepSeek 外部分析 API（只发送用户确认后的转写、题目和评分标准）
EVALUATION_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EXTERNAL_LLM_PROVIDER_ID=deepseek-api
EXTERNAL_LLM_TIMEOUT_MS=90000
# DEEPSEEK_API_KEY=请填写服务端密钥

# 如需回退到本地模型，将 EVALUATION_PROVIDER 改为 local 并启用下列配置。
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen3.6:27b
# LOCAL_LLM_PROVIDER_ID=local-qwen
# LOCAL_LLM_API_STYLE=ollama
# LOCAL_LLM_TIMEOUT_MS=300000
# LOCAL_LLM_API_KEY=
