NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_ORIGINS=https://ai-rag.online
DATABASE_PATH=/var/lib/expression-training/db/expression-training.sqlite
UPLOADS_PATH=/var/lib/expression-training/uploads

# 默认使用服务器本机 Faster-Whisper；如改云端 ASR，请填写 CLOUD_ASR_*。
ASR_PROVIDER=local
LOCAL_ASR_BASE_URL=http://127.0.0.1:9000/v1
LOCAL_ASR_MODEL=small
LOCAL_ASR_TIMEOUT_MS=180000

EVALUATION_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EXTERNAL_LLM_PROVIDER_ID=deepseek-api
EXTERNAL_LLM_TIMEOUT_MS=120000
DEEPSEEK_API_KEY=
